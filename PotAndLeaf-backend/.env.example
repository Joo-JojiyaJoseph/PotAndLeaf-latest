APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Application timezone. Commission and care jobs also honour the company setting company_timezone (default Asia/Kolkata).
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=potandleaf
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp — set WATI_* to use WATI, else TWILIO_* to use Twilio, else stub mode (logs only).
# Rates, slabs, and send times live in the database (commission rules and company settings), not here.
WATI_API_URL=
WATI_API_TOKEN=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# Approved template slugs. Matching rows in whatsapp_templates override the built-in message text.
WHATSAPP_TEMPLATE_RENTAL_INVOICE=rental_invoice
WHATSAPP_TEMPLATE_EOD_COMMISSION=eod_commission
WHATSAPP_TEMPLATE_SEASONAL_CARE=seasonal_care

VITE_APP_NAME="${APP_NAME}"
