# Used by `npm run build`. Point these at your deployed cPanel backend.
# IMPORTANT: if the frontend is served over HTTPS, these MUST be https too,
# or the browser will block the calls as mixed content. Enable AutoSSL on the
# backend subdomain in cPanel and use https here.
VITE_API_URL=https://potandleafbackend-testing-internal.webfolks.in/api
VITE_ASSET_URL=https://potandleafbackend-testing-internal.webfolks.in
