# Local dev — do NOT set VITE_API_URL here (that bypasses the Vite proxy and triggers CORS).
# npm run dev proxies /api and /storage to your local Laravel backend:
# VITE_API_PROXY=https://potandleafbackend-testing-internal.webfolks.in

# Production URLs live in .env.production (used by npm run build).
VITE_API_URL=https://potandleafbackend-testing-internal.webfolks.in